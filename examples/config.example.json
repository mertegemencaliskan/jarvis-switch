{
  "$schema": "https://raw.githubusercontent.com/mertegemencaliskan/jarvis-switch/main/config.schema.json",
  "name": "Jarvis",
  "refreshSeconds": 1,
  "menuBarText": false,
  "checkForUpdates": true,
  "openclawConfig": "~/.openclaw/openclaw.json",
  "openclawCLI": "~/.openclaw/bin/openclaw",
  "dashboardCommand": ["/usr/bin/open", "-a", "OpenClaw"],
  "offload": {
    "light": ["/opt/homebrew/bin/ollama", "stop", "qwen3:32b"],
    "restore": ["/usr/bin/curl", "-fsS", "http://127.0.0.1:11434/api/generate", "-d", "{\"model\": \"qwen3:32b\"}"],
    "lightLabel": "Unload the model; it loads again on resume"
  }
}

{
  "name": "Jarvis",
  "gatewayURL": "http://127.0.0.1:18789",
  "openclawCLI": "~/.openclaw/bin/openclaw",
  "openclawConfig": "~/.openclaw/openclaw.json",
  "modelBaseURL": "http://127.0.0.1:8000/v1",
  "dashboardCommand": ["/usr/bin/open", "-a", "OpenClaw"],
  "checkForUpdates": true,
  "offload": {
    "light": ["/path/to/your/offload-script", "--light"],
    "deep": ["/path/to/your/offload-script", "--deep"],
    "restore": ["/path/to/your/offload-script", "--restore"],
    "stateFile": "~/.local/state/my-assistant/offloaded.json",
    "lightLabel": "Offload: light (release model memory)",
    "deepLabel": "Offload: deep (stop the model server)"
  }
}
